# ==================== 依赖与库文件 ====================
# Node 依赖（本地开发/测试需要）
compressor/node_modules/

# 压缩器第三方库：发布时由 scripts/build_site.py 从 node_modules 拷贝进发布目录，不入库
compressor/luaparse.js
compressor/fengari-web.js

# ==================== 构建产物 ====================
# 由 GenerateHtml.py 生成，不入库
/index.html
/kb.json
/kb/

# ==================== Python ====================
__pycache__/

# ==================== 测试临时文件 ====================
# 远程测试缓存（首次联网拉取的外部 main.lua）
compressor/tests2/.remote-cache/

# 批量测试克隆的第三方仓库
compressor/tests2/_bulk_test_repos/

# 压缩测试语料导出（scripts/export_segments.py 生成：默认参数替换后的逐块最终代码）
compressor/tests2/_repo_segments.json

# ==================== 快照基线（保留用于回归测试）====================
# tests2/_snapshot.json（v1 历史基线）与 tests2/_baseline_v2.json（v2 自身基线）
# 均入库以便团队共享基线

# 发布目录（scripts/build_site.py 组装：只含构建产物与运行时资源，不入库）
/_site/

